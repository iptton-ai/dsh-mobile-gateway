# dsh-gateway 环境配置示例(生产放 /etc/dsh-gateway.env,不入 git)
#
# 生成 JWT 密钥: openssl rand -hex 32
DSH_GATEWAY_JWT_SECRET=
# 密码登录为可选兜底;留空 = 禁用(仅配对)。生成:
#   PASSWORD='你的密码' ./dsh-mobile-gateway --hash-password
DSH_GATEWAY_PASSWORD_HASH=
# 公开面绑定地址。默认 127.0.0.1(fail-closed:公开面只该被同机反代触达);
# Docker 端口映射形态才显式设 0.0.0.0 —— 直连可伪造 X-Real-IP 绕过限速,且是明文 HTTP
DSH_GATEWAY_BIND=127.0.0.1
DSH_GATEWAY_PORT=8102
# 管理面(仅 127.0.0.1,pair.sh 经 ssh 调用;nginx 不代理)
DSH_GATEWAY_ADMIN_PORT=8103
# 默认上游 = SSH 反向隧道落地口(单机部署用;多机各自 claim 时按端口绑定)
DSH_GATEWAY_UPSTREAM=127.0.0.1:13100
# 转发时改写的 Host(dsh 信任围栏要求 loopback authority)
DSH_GATEWAY_UPSTREAM_HOST=127.0.0.1:3080
DSH_GATEWAY_TOKEN_TTL_DAYS=30
# claim 端口白名单(每台 Mac 一个隧道端口)
DSH_GATEWAY_TUNNEL_PORT_MIN=13100
DSH_GATEWAY_TUNNEL_PORT_MAX=13199
# SQLite 路径相对 WorkingDirectory=/var/lib/dsh-gateway
DSH_GATEWAY_DATABASE=dsh-gateway.db

# 管理面 bearer token(生产必设:管理面虽绑 loopback,同机任意进程都能连;
# 空值 = 不鉴权,仅限本地联调)
DSH_GATEWAY_ADMIN_TOKEN=

# 隧道 UDS 落点目录(可选)。设置后令牌绑定端口 N 优先走 {dir}/tunnel-{N}.sock
# (ssh -R 直落 socket,目录属主即访问控制),socket 不在自动回落 TCP。
# DSH_GATEWAY_TUNNEL_SOCK_DIR=/run/dsh-gateway
